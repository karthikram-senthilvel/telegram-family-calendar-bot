# ---- Telegram ----------------------------------------------------------------
# Token from @BotFather. If it was ever pasted in a chat, revoke it there (/revoke) and use the new one.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to use the bot (you and your family members).
# Get an ID by messaging @userinfobot. Messages from anyone else are ignored (and logged).
ALLOWED_USER_IDS=
# Who gets restart / "bot is down" alerts. Defaults to ALLOWED_USER_IDS.
ADMIN_USER_IDS=

# ---- Language model -------------------------------------------------------
# gemini (default) = Google Gemini API key from aistudio.google.com/apikey.
#   PRIVACY: enable billing on the key's project (paid tier). On the free tier Google
#   may use prompts to improve its products; on the paid tier it does not.
# openrouter       = OpenRouter key (set OPENROUTER_* below instead).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# First model is primary, the rest are fallbacks. Check names with:
#   docker compose run --rm bot python -m app.cli --list-models
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash

# Only used when LLM_PROVIDER=openrouter. Only anthropic/, openai/, google/ models are accepted.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=anthropic/claude-haiku-5.5,anthropic/claude-sonnet-5.5
OPENROUTER_ZDR=true

# ---- Calendar ---------------------------------------------------------------
TIMEZONE=America/Chicago
DEFAULT_DURATION_MINUTES=60
# google  = a dedicated secondary calendar in your household Google account (see README)
# caldav  = local Radicale server (temporary)
CALENDAR_BACKEND=google

# Optional: override the calendar id saved by authorize_google.py (must be a secondary calendar).
# GOOGLE_CALENDAR_ID=

# Radicale / CalDAV (only when CALENDAR_BACKEND=caldav). Uncomment COMPOSE_PROFILES to run Radicale.
# COMPOSE_PROFILES=radicale
CALDAV_URL=http://radicale:5232/
CALDAV_USERNAME=family
CALDAV_PASSWORD=
CALDAV_CALENDAR_NAME=Family

NOTIFY_ON_START=true

# ---- Voice notes (local speech-to-text container) ---------------------------
# Leave STT_URL empty to disable voice notes.
STT_URL=http://stt:8000
VOICE_MAX_SECONDS=120
# Place names the speech model may mis-hear; the LLM uses them to fix transcripts.
LOCAL_PLACES=Plano, Frisco, McKinney, Allen, Prosper, Richardson, Dallas
